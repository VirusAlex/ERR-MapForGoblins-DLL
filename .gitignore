# Release publishing notes (per-platform changelog texts, personal copy-paste aid).
# Lives in releases\ now (covered by releases/ above); the bare name is kept as a
# belt-and-suspenders guard in case anything writes one at the repo root.
releases/CHANGELOG.txt
CHANGELOG.txt

